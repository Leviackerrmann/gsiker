# .env de PRODUCCIÓN (VPS). Copia a ~/nebula/shared/.env y pon valores reales.
# NUNCA subir a git. Usar secretos ROTADOS (no los de prueba/local).

# --- Base de datos ---
POSTGRES_USER=comprasuser
POSTGRES_PASSWORD=CAMBIAR_password_fuerte
POSTGRES_DB=minisapdb

# --- Rol de aplicación (RLS) ---
APP_DB_USER=nebula_app
APP_DB_PASSWORD=CAMBIAR_password_app

# --- Backend ---
SECRET_KEY=CAMBIAR_clave_larga_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# El SPA se sirve same-origin, así que CORS apunta al host público.
CORS_ORIGINS=http://161.153.59.104

# --- Frontend ---
# En prod el API es same-origin: el router enruta /api al backend activo.
VITE_API_URL=/api

# --- Asistente IA (proveedor gratis por defecto: Groq) ---
IA_PROVIDER=groq
IA_MODEL=
GROQ_API_KEY=CAMBIAR_groq_key_rotada
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Bot de Telegram (PROD: @gsikerbot, token rotado) ---
TELEGRAM_ENABLED=True
TELEGRAM_BOT_TOKEN=CAMBIAR_token_prod_rotado
TELEGRAM_EMPRESA_ID=1
