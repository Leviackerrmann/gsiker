# Copia este archivo a .env y ajusta los valores.

# --- Base de datos (contenedor postgres) ---
# Dueño de las tablas. Lo usan las MIGRACIONES (no está sujeto a RLS).
POSTGRES_USER=comprasuser
POSTGRES_PASSWORD=compraspass
POSTGRES_DB=minisapdb

# --- Rol de aplicación (RLS) ---
# Rol SIN privilegios con el que se conecta el backend en runtime. Es lo que
# hace que la Row-Level Security aísle por empresa. Cambia la clave en prod.
APP_DB_USER=nebula_app
APP_DB_PASSWORD=nebula_app_dev

# --- Backend ---
# En local sin Docker, apunta la app al rol sin privilegios:
#   DATABASE_URL=postgresql+asyncpg://nebula_app:nebula_app_dev@localhost:5433/minisapdb
# y las migraciones al dueño:
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://comprasuser:compraspass@localhost:5433/minisapdb
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Asistente IA ---
# Proveedor: groq (gratis) | gemini | openrouter | ollama | openai | anthropic.
IA_PROVIDER=groq
# Modelo (vacío = usa el default del proveedor; groq → llama-3.3-70b-versatile).
IA_MODEL=
# Consigue una API key gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Para migrar a Claude de pago luego: IA_PROVIDER=anthropic + ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# --- Bot de Telegram (canal de chat del asistente) ---
# Token del bot que te da @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
# Empresa a la que responde el bot en pruebas (1 = demo).
TELEGRAM_EMPRESA_ID=1

# --- Frontend ---
# URL base del API que consume la SPA (se hornea en build)
VITE_API_URL=http://localhost:8000/api
