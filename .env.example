# Copia este archivo a .env y ajusta los valores.

# --- Base de datos (contenedor postgres) ---
POSTGRES_USER=comprasuser
POSTGRES_PASSWORD=compraspass
POSTGRES_DB=minisapdb

# --- Backend ---
# En local sin Docker: postgresql+asyncpg://comprasuser@localhost/minisapdb
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
# URL base del API que consume la SPA (se hornea en build)
VITE_API_URL=http://localhost:8000/api
